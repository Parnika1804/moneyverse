# Server Configuration
PORT=5000
NODE_ENV=development
GCP_PROJECT_ID=your-gcp-project-id

# Allowed Frontend Origins (comma-separated; set to your Vercel URL in Render)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Firebase Admin Authentication (choose ONE method — NEVER commit real secrets):
# 1. Local dev with JSON key file:
#    GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# 2. Render / PaaS environment variable (paste raw JSON or Base64-encoded JSON):
#    FIREBASE_SERVICE_ACCOUNT_JSON=
# 3. Google Cloud Run / gcloud ADC:
#    Leave both unset to use Application Default Credentials automatically.

# Optional Google Cloud Storage lessons bucket (leave empty to use local server/content/lessons.json)
GCS_BUCKET_NAME=
