# Backend API Base URL
# Local dev: leave unset (defaults to /api via Vite proxy) or use http://127.0.0.1:5000/api
# Vercel production: https://<your-render-service>.onrender.com/api
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Public Firebase Web App Configuration (safe for client bundle)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
